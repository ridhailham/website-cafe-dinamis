# ============================================================
# KOPI SENJA — Environment Variables
# Salin file ini menjadi `.env.local` untuk local development.
# Untuk DEPLOY ke Vercel, set variabel yang sama di:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# (WAJIB) Database Neon Postgres
# Buat proyek di https://neon.tech lalu salin connection string (pooled) di sini.
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# (WAJIB) Kredensial admin — ganti sebelum serah terima ke klien!
ADMIN_EMAIL=admin@kopi-senja.com
ADMIN_PASSWORD=ganti-password-anda

# (WAJIB) Kunci penandatanganan session JWT — JANGAN dibagikan / di-commit.
# Sekarang kodingan MEWAJIBKAN ini diset (tidak ada fallback hardcoded).
# Generate dengan:  openssl rand -base64 32
AUTH_SECRET=generate-dengan-openssl-rand

# Vercel Blob Storage untuk upload foto menu.
# OTOMATIS tersedia di Vercel bila mengaktifkan Blob Store pada project,
# jadi TIDAK perlu diset manual di production.
# Untuk local dev, set nilai token dari https://vercel.com/stores.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
